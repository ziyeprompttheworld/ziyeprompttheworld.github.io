      "entries": [
        {
          "id": "d-2022-06-14",
          "date": "2022-06-14",
          "title": "2022.6.14～2022.7.16｜阅读《价值》，思考工作与生活",
          "html": "<p><b>发生了什么：</b>以地铁阅读、雨天和花为日常，我围绕《价值》继续思考长期主义、工作选择与幸福。</p><figure><img src=\"/diary-media/diary-img-097452c586d27f83.webp\" width=\"1332\" height=\"1900\" loading=\"lazy\" decoding=\"async\" alt=\"2022.6.14～2022.7.16 初夏朋友圈记录\n\"/><figcaption>2022.6.14～2022.7.16 初夏朋友圈记录\n</figcaption></figure>",
          "topics": [],
